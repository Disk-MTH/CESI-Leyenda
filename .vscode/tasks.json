{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "deliverable",
      "type": "pickString",
      "description": "Deliverable notebook",
      "options": ["1", "2", "3"],
      "default": "3"
    },
    {
      "id": "notebook",
      "type": "pickString",
      "description": "Executed notebook to check",
      "options": [
        "notebooks/livrable1_classification_binaire.ipynb",
        "notebooks/livrable2_traitement_images.ipynb",
        "notebooks/livrable3_captioning.ipynb"
      ]
    },
    {
      "id": "folder",
      "type": "promptString",
      "description": "Folder of images to caption",
      "default": "data/demo"
    }
  ],
  "tasks": [
    {
      "label": "Tests (pytest)",
      "type": "shell",
      "command": "uv run pytest -q",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Notebook: quick run (writes *.quick.ipynb only, ignored by git)",
      "type": "shell",
      "command": "bash scripts/run_notebook.sh ${input:deliverable} quick",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Notebook: full run (rebuilds the deliverable .ipynb and its models)",
      "type": "shell",
      "command": "bash scripts/run_notebook.sh ${input:deliverable} full",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Check an executed deliverable notebook",
      "type": "shell",
      "command": "uv run python scripts/check_notebook.py ${input:notebook}",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Caption a folder (complete workflow)",
      "type": "shell",
      "command": "uv run python scripts/caption_folder.py ${input:folder} --out data/captions.csv",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
